{
	"cpu": 0.2,
	"id": "ecopulseheadlessauth",
	"kind": "Deployment",
	"loadBalancer": {
		"targetPort": 3002
	},
	"ports": [
		{
			"external": true,
			"port": 3002
		}
	],
	"memory": 50,
	"scale": 1,
	"readinessProbe": {
		"httpGet": {
			"path": "/ready",
			"port": 3002
		},
		"initialDelaySeconds": 5,
		"periodSeconds": 10,
		"timeoutSeconds": 4,
		"failureThreshold": 3,
		"successThreshold": 1
	},
	"livenessProbe": {
		"httpGet": {
			"path": "/ready",
			"port": 3002
		},
		"initialDelaySeconds": 10,
		"periodSeconds": 10,
		"timeoutSeconds": 4,
		"failureThreshold": 3,
		"successThreshold": 1
	}
}
