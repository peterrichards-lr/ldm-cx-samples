{
	"cpu": 0.2,
	"id": "ecopulseobjectaction",
	"kind": "Deployment",
	"loadBalancer": {
		"targetPort": 3003
	},
	"ports": [
		{
			"external": true,
			"port": 3003
		}
	],
	"memory": 50,
	"scale": 1,
	"readinessProbe": {
		"httpGet": {
			"path": "/ready",
			"port": 3003
		},
		"initialDelaySeconds": 5,
		"periodSeconds": 10,
		"timeoutSeconds": 4,
		"failureThreshold": 3,
		"successThreshold": 1
	},
	"livenessProbe": {
		"httpGet": {
			"path": "/ready",
			"port": 3003
		},
		"initialDelaySeconds": 10,
		"periodSeconds": 10,
		"timeoutSeconds": 4,
		"failureThreshold": 3,
		"successThreshold": 1
	}
}
